# Client Frontend Environment Variables
VITE_API_HOST=http://localhost:5000

# Client-Server Cryptographic Salt (Must match Server SALT exactly)
VITE_SALT=a3f1c8d9e27b4f56a8e2d5c6f3a9e4b7f1d2c3e4a5b6c7d8e9f0a1b2c3d4e5f6

# Firebase Authentication (Optional if using standard email/password)
VITE_FIREBASE_APIKEY=your_firebase_api_key
VITE_FIREBASE_AUTHDOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECTID=your_project_id
VITE_FIREBASE_STORAGEBUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGINGSENDERID=your_sender_id
VITE_FIREBASE_APPID=your_app_id
